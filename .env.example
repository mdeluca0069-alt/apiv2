NODE_ENV=development
# PRODUCTION CUTOVER Stage 3: 3000 is this repo's LOCAL DEV default (matches
# `npm run dev` / this file's own convention). The docker-compose.prod.yml
# deployment path always overrides PORT to 3001 in its own `environment:`
# block, and the Dockerfile never copies a .env file into the image at all --
# this file's PORT value is never actually read in that path. Kept at 3000
# here only to match local dev; do not "fix" it to 3001 without also
# reconciling docker-compose.prod.yml's override, or the two will just swap
# which one is the mismatch.
PORT=3000
DATABASE_URL=postgresql://igfxpro:igfxpro@localhost:5432/igfxpro?schema=public
REDIS_URL=redis://localhost:6379

# REQUIRED — generate with: openssl rand -hex 64
# Never commit a real value. Never use a default.
JWT_SECRET=

# RSA keys for RS256 (recommended for production — overrides JWT_SECRET when both are set)
# Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Then set the values as single-line with \n separating lines:
#   JWT_PRIVATE_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem)"
#   JWT_PUBLIC_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' public.pem)"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

CORS_ORIGIN=http://localhost:5173
LIVE_TRADING_ENABLED=false

# Public frontend URL — used to build links inside transactional emails (welcome, support, etc.)
FRONTEND_URL=http://localhost:5173
# Support contact address shown to clients in emails and on the dashboard
SUPPORT_EMAIL=support@igfxpro.com

# Outbound transactional email (SMTP) — required for welcome/KYC/support/order emails to actually
# reach a real inbox. Without these set, emails are only logged to console ("sandbox mode").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@igfxpro.com

# External market data feeds (required for real quotes)
TWELVEDATA_API_KEY=

# Finnhub — second real-time WebSocket source for stocks & crypto (optional but recommended)
# Free plan covers: AAPL, MSFT, NVDA, TSLA, AMZN, BTC/ETH via Binance
# Get key: finnhub.io/dashboard
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=

# Twelve Data WebSocket symbols to subscribe (comma-separated)
MARKET_SYMBOLS=EUR/USD,XAU/USD,BTC/USD,AAPL,SPY

# ── Anthropic / Claude AI ─────────────────────────────────────────────────────
# Powers OLOS Assistant chat (get key from console.anthropic.com)
# REQUIRED — server will refuse to start if absent
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Document Storage ────────────────────────────────────────────────────────────
# Set STORAGE_PROVIDER to "R2" (Cloudflare) or "S3" (AWS). Default: R2
STORAGE_PROVIDER=R2

# Cloudflare R2 (used when STORAGE_PROVIDER=R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=igfxpro-documents

# AWS S3 (used when STORAGE_PROVIDER=S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=igfxpro-documents
# Optional: KMS key ARN for SSE-KMS (leave blank to use AES256 SSE-S3)
AWS_KMS_KEY_ID=

# Client-side AES-256-GCM envelope encryption master key.
# Every file is encrypted with a unique DEK; this key encrypts the DEK.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse across environments. Rotation requires re-encrypting stored DEKs.
STORAGE_MASTER_KEY=

# Public-facing API base URL — used to construct the virus-scan callback URL
PUBLIC_API_URL=https://api.yourdomain.com

# Virus scanning (files skip quarantine when disabled)
# Scanner must POST result to POST /api/v1/documents/scan-result, signed
# with HMAC-SHA256 (hex) over the raw body using VIRUS_SCAN_WEBHOOK_SECRET,
# sent in the X-Scan-Signature header. Required — the callback is rejected
# with no secret configured (fail-closed), not silently accepted.
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_URL=
VIRUS_SCAN_TOKEN=
VIRUS_SCAN_WEBHOOK_SECRET=

# ── KYC / Identity Verification (Sumsub) ────────────────────────────────────
# Required for automated OCR + liveness checks.
# Without these the platform falls back to manual review for every KYC submission.
#
# 1. Create a free/paid account at https://sumsub.com
# 2. Dashboard → Developers → App tokens → create a production token
# 3. Dashboard → Webhooks → create endpoint → copy the secret
# 4. Dashboard → Applicant levels → note your level name (e.g. "basic-kyc-level")
#
OCR_PROVIDER=sumsub
LIVENESS_PROVIDER=sumsub
SUMSUB_APP_TOKEN=          # App Token from Sumsub dashboard
SUMSUB_SECRET_KEY=         # Secret Key from Sumsub dashboard
SUMSUB_WEBHOOK_SECRET=     # Webhook secret (Sumsub → Webhooks → your endpoint)
SUMSUB_LEVEL_NAME=basic-kyc-level

# ── PRODUCTION CUTOVER Stage 3B — additional variables found via a full
# process.env audit of the codebase, not previously documented here.
# Everything below has a safe default if omitted UNLESS noted otherwise.

# Prometheus /metrics scrape auth (docker-compose.monitoring.yml renders this
# into a bearer-token credentials file for Prometheus). Leave unset to serve
# /metrics with no auth (fine on a network Prometheus alone can reach).
METRICS_TOKEN=

# Node's libuv threadpool size — auth-service/password.hasher.ts's argon2id
# hash()/verify() calls run as libuv threadpool work items, NOT on the main
# event loop. The Node.js default (4) hard-caps concurrent password hashing
# to 4 operations at a time PER REPLICA regardless of CPU core count or
# argon2's own cost parameters -- confirmed as a real contributing factor to
# login-burst latency under concurrent load (SHADOW_PRODUCTION_REPORT.md).
# 16 is a reasonable default; tune against the real host's core count.
UV_THREADPOOL_SIZE=16

# ── Secret management backend (security/secrets-vault.ts) ──────────────────
# "env" (default) reads directly from process.env -- fine for a single-host
# deployment with secrets injected by the orchestrator. For a real secrets
# manager, set VAULT_BACKEND=vault (HashiCorp Vault KV v2) or =aws (AWS
# Secrets Manager); see secrets-vault.ts for exact behavior of each.
VAULT_BACKEND=env
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_AWS_REGION=

# ── PostgreSQL backup (scripts/backup.sh, docker-compose.prod.yml's `backup`
# service) ───────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=

# ── Alertmanager (docker-compose.monitoring.yml + deployment/monitoring/
# alertmanager.yml) — without real values, alerts still fire and route
# correctly (verified this Stage) but delivery to Slack/PagerDuty/email will
# not actually reach anyone until these are set to real credentials.
ALERTMANAGER_SLACK_WEBHOOK=
ALERTMANAGER_PAGERDUTY_KEY=
COMPLIANCE_EMAIL=compliance@igfxpro.com
GF_ADMIN_PASSWORD=

# ── Compliance audit-log archival (security/immutable.audit.ts) — optional.
# Without these, AuditLog rows are still retained in Postgres per the 7-year
# MiFID II policy (settlement/data.retention.service.ts, never auto-deleted
# regardless), but never copied to cold storage.
AUDIT_ARCHIVE_S3_BUCKET=
AUDIT_CLOUDWATCH_LOG_GROUP=
