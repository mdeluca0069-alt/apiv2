{
  "__inputs": [{ "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" }],
  "annotations": { "list": [] },
  "description": "IGFXPRO-OLOS — Production Overview: Orders, Settlement, Risk, DB, WebSocket",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "📈 ORDER PIPELINE", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(orders_filled_total[1m])", "legendFormat": "Filled/s" },
        { "expr": "rate(orders_rejected_total[1m])", "legendFormat": "Rejected/s" },
        { "expr": "rate(orders_placed_total[1m])", "legendFormat": "Placed/s" }
      ],
      "title": "Order Rate (per second)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 }] },
          "unit": "ms"
        }, "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(order_duration_ms_bucket[5m]))", "legendFormat": "Order P95" },
        { "expr": "histogram_quantile(0.99, rate(order_duration_ms_bucket[5m]))", "legendFormat": "Order P99" }
      ],
      "title": "Order Latency (P95 / P99)",
      "type": "gauge"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 101, "title": "💰 SETTLEMENT & P&L", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2 }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(settlement_duration_ms_bucket[5m]))", "legendFormat": "Settlement P50" },
        { "expr": "histogram_quantile(0.95, rate(settlement_duration_ms_bucket[5m]))", "legendFormat": "Settlement P95" },
        { "expr": "histogram_quantile(0.99, rate(settlement_duration_ms_bucket[5m]))", "legendFormat": "Settlement P99" }
      ],
      "title": "Settlement Latency",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": { "legend": { "calcs": ["last", "diff"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(settlement_completed_total[1m])", "legendFormat": "Settlements/s" },
        { "expr": "rate(settlement_errors_total[1m])", "legendFormat": "Errors/s" },
        { "expr": "rate(margin_discrepancies_total[1m])", "legendFormat": "Margin Discrepancies/s" }
      ],
      "title": "Settlement Rate & Errors",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto" },
      "targets": [{ "expr": "margin_discrepancies_total", "legendFormat": "Margin Discrepancies" }],
      "title": "Margin Discrepancies (total)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto" },
      "targets": [{ "expr": "reconciliation_dirty_users", "legendFormat": "Dirty Users" }],
      "title": "Reconciliation Mismatches (users)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 18 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto" },
      "targets": [{ "expr": "stop_out_events_total", "legendFormat": "Stop-Outs" }],
      "title": "Stop-Out Events (total)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 18 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto" },
      "targets": [{ "expr": "negative_balance_clips_total", "legendFormat": "NBP Clips" }],
      "title": "Negative Balance Clips (total)",
      "type": "stat"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "id": 102, "title": "⚡ STOP-OUT & RISK", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 9,
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(stop_out_events_total[5m]) * 60", "legendFormat": "Stop-Outs/min" },
        { "expr": "rate(margin_calls_total[5m]) * 60", "legendFormat": "Margin Calls/min" },
        { "expr": "rate(stop_loss_triggers_total[5m]) * 60", "legendFormat": "SL Triggers/min" },
        { "expr": "rate(take_profit_triggers_total[5m]) * 60", "legendFormat": "TP Triggers/min" }
      ],
      "title": "Risk Events Rate",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2 }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 10,
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(stopout_duration_ms_bucket[5m]))", "legendFormat": "Stop-Out P95" },
        { "expr": "histogram_quantile(0.99, rate(stopout_duration_ms_bucket[5m]))", "legendFormat": "Stop-Out P99" }
      ],
      "title": "Stop-Out Scan Latency",
      "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "id": 103, "title": "🗄️ DATABASE", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2 }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 11,
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(db_query_duration_ms_bucket[5m]))", "legendFormat": "DB P50" },
        { "expr": "histogram_quantile(0.95, rate(db_query_duration_ms_bucket[5m]))", "legendFormat": "DB P95" },
        { "expr": "histogram_quantile(0.99, rate(db_query_duration_ms_bucket[5m]))", "legendFormat": "DB P99" }
      ],
      "title": "Database Query Latency",
      "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "id": 104, "title": "🌐 WEBSOCKET & HTTP", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "id": 12,
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "ws_connections_active", "legendFormat": "Active WS Connections" },
        { "expr": "outbox_queue_depth", "legendFormat": "Outbox Queue Depth" }
      ],
      "title": "WebSocket Connections & Outbox",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "id": 13,
      "options": { "legend": { "calcs": ["last", "sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(http_requests_2xx_total[1m])", "legendFormat": "2xx/s" },
        { "expr": "rate(http_requests_4xx_total[1m])", "legendFormat": "4xx/s" },
        { "expr": "rate(http_requests_5xx_total[1m])", "legendFormat": "5xx/s" }
      ],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 }, "id": 105, "title": "🖥️ PROCESS HEALTH", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "id": 14,
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "process_memory_rss_bytes", "legendFormat": "RSS" },
        { "expr": "process_memory_heap_used_bytes", "legendFormat": "Heap Used" }
      ],
      "title": "Node.js Memory Usage",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "id": 15,
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "process_uptime_seconds", "legendFormat": "Uptime (s)" }],
      "title": "Process Uptime",
      "type": "timeseries"
    }

  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["igfxpro", "trading", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "UTC",
  "title": "IGFXPRO-OLOS — Production Overview",
  "uid": "igfxpro-overview-v1",
  "version": 1
}
