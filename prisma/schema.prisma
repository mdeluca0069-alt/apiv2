  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([caseId])
  @@index([documentKey, status])
}

model KycVerificationStep {
  id         String   @id @default(uuid())
  caseId     String
  stepType   String
  status     String   @default("PENDING")
