model SupportTicket {
  id          String    @id @default(uuid())
  userId      String
  subject     String
  message     String
  status      String    @default("OPEN")
  priority    String    @default("NORMAL")
  category    String    @default("GENERAL")
  resolution  String?
  resolvedAt  DateTime?
  slaDeadline DateTime?
  agentNote   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  User        User      @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([status, priority])
  @@index([userId, status])
}

model SignalTelemetry {
  id         String @id @default(uuid())
  signalId   String @unique
  symbol     String
  timeframe  String @default("1H")
  signalType String // BUY | SELL
  confidence Float

  // Market context snapshot at signal generation time
  entryPrice         Decimal @db.Decimal(18, 8)
  stopLoss           Decimal @db.Decimal(18, 8)
  target1            Decimal @db.Decimal(18, 8)
  target2            Decimal @db.Decimal(18, 8)
  riskRewardRatio    Float
  marketRegime       String
  volatilityLevel    String
  confluenceFactors  Json // string[]
  indicatorsSnapshot Json // rsi, macd, ema50, ema200, atr values

  // Execution linkage (null = signal not executed by autopilot)
  positionId       String?  @unique
  orderId          String?
  actualEntryPrice Decimal? @db.Decimal(18, 8)

  // Outcome — filled when position closes
  outcome         String   @default("PENDING") // PENDING | WIN | LOSS | BREAKEVEN | EXPIRED
  pnl             Decimal? @db.Decimal(18, 8)
  pnlPips         Float?
  exitPrice       Decimal? @db.Decimal(18, 8)
  exitReason      String? // TP_HIT | SL_HIT | MANUAL | STOP_OUT | EXPIRED
  durationSeconds Int?

  // Max Favorable Excursion / Max Adverse Excursion (in price units)
  maxFavorableExcursion Decimal? @db.Decimal(18, 8)
  maxAdverseExcursion   Decimal? @db.Decimal(18, 8)

  generatedAt DateTime
  executedAt  DateTime?
  closedAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([symbol, outcome])
  @@index([marketRegime, outcome])
  @@index([confidence])
  @@index([generatedAt])
  @@index([outcome, generatedAt])
  @@index([signalType, outcome])
}

model SwapAccrual {
  id             String   @id @default(uuid())
  positionId     String
  userId         String
  symbol         String
  side           String
  swapAmount     Decimal  @db.Decimal(18, 8)
  swapRateAnnual Decimal  @db.Decimal(10, 6)
  nights         Int
  accrualDate    DateTime @db.Date
  settlementId   String?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])

  @@unique([positionId, accrualDate])
  @@index([positionId])
  @@index([userId, accrualDate])
}

model Tenant {
  id        String   @id
  name      String
  region    String
  createdAt DateTime @default(now())
  User      User[]
}

model TradeAudit {
  // Fix #11: composite PK — see the identical note on LedgerEntry above.
  // Same Task-14 partitioning migration, same real DB PK shape
  // ("TradeAudit_pkey1" on (id, createdAt)), same prior drift.
  id            String    @default(uuid())
  userId        String
  orderId       String?
  positionId    String?
  symbol        String
  side          String
  quantity      Decimal
  entryPrice    Decimal?
  exitPrice     Decimal?
  stopLoss      Decimal?
  takeProfit    Decimal?
  pnlRealized   Decimal?
  pnlUnrealized Decimal?
  pnlPercent    Decimal?
  marginUsed    Decimal?
  leverage      Int?
  fees          Decimal   @default(0)
  slippage      Decimal   @default(0)
  duration      Int?
  tradeStatus   String
  lifecycle     Json
  riskMetrics   Json
  createdAt     DateTime  @default(now())
  closedAt      DateTime?
  updatedAt     DateTime  @updatedAt
  User          User      @relation(fields: [userId], references: [id])
  // FASE 2.4: idempotency key for compliance/audit.outbox.consumer.ts — the
  // OutboxEvent row this TradeAudit row was built from. A retry after the
  // audit transaction committed but whose ack was lost (rare, but the
  // transaction alone can't rule it out) hits this unique constraint on the
  // re-attempted INSERT instead of writing a second, duplicate row; the
  // consumer treats that as success. Nullable: only rows created via the
  // outbox path (FASE 2.4 onward) set it — pre-2.4 rows have none.
  //
  // Composite with createdAt (not a plain unique) because TradeAudit is
  // partitioned by createdAt (Task 14) — Postgres requires every unique
  // index on a partitioned table to include the partition key. This only
  // works because the consumer sets createdAt explicitly from the source
  // OutboxEvent's own createdAt, not `now()` — deterministic across retries,
  // so the composite key is exactly as unique as sourceOutboxId alone.
  sourceOutboxId String?

  @@id([id, createdAt])
  @@unique([sourceOutboxId, createdAt])
  @@index([orderId])
  @@index([positionId])
  @@index([symbol, tradeStatus])
  @@index([userId, createdAt])
  @@index([userId, tradeStatus])
}

model User {
  id                  String                @id
  email               String                @unique
  password            String
  fullName            String
  role                String
  roles               Json
  permissions         Json
  tier                String
  kycStatus           String
  tenantId            String
  createdAt           DateTime              @default(now())
  AutopilotConfig     AutopilotConfig?
  ClientDocument      ClientDocument[]
  KycCase             KycCase?
  LedgerEntry         LedgerEntry[]
  MarginSnapshot      MarginSnapshot[]
  OlosSignal          OlosSignal[]
  Order               Order[]
  Position            Position[]
  RiskWarning         RiskWarning[]
  Session             Session[]
  StoredDocument      StoredDocument[]
  SupportTicket       SupportTicket[]
  Watchlist           Watchlist[]
  SwapAccrual         SwapAccrual[]
  TradeAudit          TradeAudit[]
  Tenant              Tenant                @relation(fields: [tenantId], references: [id])
  UserAcademyProgress UserAcademyProgress[]
  WalletAccount       WalletAccount?
  DepositTransaction  DepositTransaction[]
  AffiliateReferral   AffiliateReferral?
}

// ── Affiliate / IB referral program ───────────────────────────────────────────

model Affiliate {
  id            String                @id @default(uuid())
  name          String
  email         String                @unique
  code          String                @unique
  commissionPct Decimal               @default(20) @db.Decimal(5, 2)
  status        String                @default("PENDING") // PENDING | ACTIVE | INACTIVE
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  Referrals     AffiliateReferral[]
  Commissions   AffiliateCommission[]

  @@index([status])
}

model AffiliateReferral {
  id          String    @id @default(uuid())
  affiliateId String
  userId      String    @unique
  createdAt   DateTime  @default(now())
  Affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  User        User      @relation(fields: [userId], references: [id])

  @@index([affiliateId, createdAt])
}

model AffiliateCommission {
  id          String    @id @default(uuid())
  affiliateId String
  userId      String
  sourceType  String // DEPOSIT
  sourceRef   String // DepositTransaction.id — also dedupes double-counting
  amount      Decimal   @db.Decimal(18, 8)
  currency    String    @default("USD")
  status      String    @default("PENDING") // PENDING | PAID | VOID
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  Affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@unique([sourceType, sourceRef])
  @@index([affiliateId, status])
}

model UserAcademyProgress {
  id           String    @id @default(uuid())
  userId       String
  contentId    String
  progress     Decimal   @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  lastViewedAt DateTime  @default(now())
  notes        String?
  rating       Decimal?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  User         User      @relation(fields: [userId], references: [id])

  @@unique([userId, contentId])
  @@index([userId])
}

model WalletAccount {
  id        String   @id @default(uuid())
  userId    String   @unique
  currency  String   @default("USD")
  balance   Decimal  @default(0) @db.Decimal(18, 8)
  equity    Decimal  @default(0) @db.Decimal(18, 8)
  locked    Decimal  @default(0) @db.Decimal(18, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// DepositTransaction is the source-of-truth for every deposit lifecycle.
// LedgerEntry is only created once the deposit reaches CREDITED — never before.
// pspRef is unique: prevents two rows for the same PSP transaction (double-credit guard layer 1).
// Status transitions are enforced by a serializable DB transaction (layer 2).
model DepositTransaction {
  id          String    @id @default(cuid())
  userId      String
  psp         String // STRIPE | NUVEI | PRAXIS
  pspRef      String?   @unique // PSP's canonical transaction / payment-intent ID
  sessionId   String? // PSP checkout/session ID (may differ from pspRef)
  amount      Decimal   @db.Decimal(18, 8)
  currency    String    @default("USD")
  status      String // REQUESTED | PENDING | CONFIRMED | CREDITED | FAILED | EXPIRED
  redirectUrl String?
  returnUrl   String?
  webhookData Json?
  failReason  String?
  requestedAt DateTime  @default(now())
  pendingAt   DateTime?
  confirmedAt DateTime?
  creditedAt  DateTime?
  User        User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([userId, requestedAt])
  @@index([psp, status])
  @@index([status, requestedAt])
}

// ── OLOS Adaptive Intelligence ────────────────────────────────────────────────

// Versioned confidence weight set produced by the weekly self-optimizer.
// The highest version is always the active set. Previous versions are retained
// for audit and rollback purposes.
model ConfidenceWeights {
  id           String   @id @default(uuid())
  version      Int      @unique
  weights      Json // Record<DimensionKey, number> — normalized to sum 100
  regimeGates  Json // Record<MarketRegime, minConfidence>
  symbolConfig Json // Record<symbol, {enabled: boolean, reason: string}>
  sampleSize   Int
  winRate      Float
  profitFactor Float
  sharpeRatio  Float
  computedAt   DateTime
  createdAt    DateTime @default(now())

  @@index([version])
}

// Economic calendar events from ForexFactory, TradingEconomics, FRED, Finnhub.
// Refreshed every 6 hours. Drives macroEventInNext4Hours() signal suppression.
model EconomicEvent {
  id        String   @id @default(uuid())
  country   String
  currency  String
  title     String
  impact    String // "low" | "medium" | "high"
  source    String   @default("UNKNOWN") // "FOREXFACTORY" | "TRADINGECONOMICS" | "FRED" | "FINNHUB"
  eventTime DateTime
  actual    String?
  forecast  String?
  previous  String?
  createdAt DateTime @default(now())

  @@unique([currency, eventTime, title, source])
  @@index([eventTime])
  @@index([currency, impact, eventTime])
  @@index([source, eventTime])
}

// Audit trail for every weekly self-optimization run.
model OptimizationLog {
  id                String   @id @default(uuid())
  runAt             DateTime
  sampleSize        Int
  previousVersion   Int?
  newVersion        Int
  weightChanges     Json // Record<DimensionKey, {before: number, after: number, delta: number}>
  symbolChanges     Json // Record<symbol, "enabled" | "disabled" | "unchanged">
  regimeGateChanges Json // Record<regime, {before: number, after: number}>
  winRateBefore     Float?
  winRateAfter      Float
  profitFactorAfter Float
  sharpeAfter       Float
  notes             String
  createdAt         DateTime @default(now())
}
