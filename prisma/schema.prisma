  @@index([symbol, status])
  @@index([userId, createdAt])
  @@index([userId, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Order {
  id               String     @id @default(uuid())
  clientOrderId    String?
  userId           String
  symbol           String
  side             String
  type             String
  status           String
  quantity         Decimal    @db.Decimal(18, 8)
  filledQuantity   Decimal    @default(0) @db.Decimal(18, 8)
  requestedPrice   Decimal?   @db.Decimal(18, 8)
  averageFillPrice Decimal?   @db.Decimal(18, 8)
  notional         Decimal    @db.Decimal(18, 8)
  marginRequired   Decimal    @db.Decimal(18, 8)
  leverage         Int        @default(1)
  stopLoss         Decimal?   @db.Decimal(18, 8)
  takeProfit       Decimal?   @db.Decimal(18, 8)
  slippage         Decimal    @default(0) @db.Decimal(18, 8)
  fees             Decimal    @default(0) @db.Decimal(18, 8)
  riskCheckResult  Json?
  rejectionReason  String?
  filledAt         DateTime?
  createdAt        DateTime   @default(now())
  Instrument       Instrument @relation(fields: [symbol], references: [symbol])
  User             User       @relation(fields: [userId], references: [id])
  Position         Position[]
  fills            Fill[]

  @@unique([userId, clientOrderId])
  @@index([symbol, status])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model Fill {
  id                String    @id @default(uuid())
  orderId           String
  positionId        String?
  quantity          Decimal   @db.Decimal(18, 8)
  price             Decimal   @db.Decimal(18, 8)
  liquidityProvider String    @default("IGFX_INTERNAL")
  slippage          Decimal   @default(0) @db.Decimal(18, 8)
  fees              Decimal   @default(0) @db.Decimal(18, 8)
  createdAt         DateTime  @default(now())
  Order             Order     @relation(fields: [orderId], references: [id])
  Position          Position? @relation(fields: [positionId], references: [id])

  @@index([orderId])
  @@index([positionId])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  published   Boolean   @default(false)
  publishedAt DateTime?
  retries     Int       @default(0)
  createdAt   DateTime  @default(now())
  userId      String?
  // FASE 2.4: separate delivery track for the audit consumer
  // (compliance/audit.outbox.consumer.ts). Defaults to true — most event
  // types (risk warnings, wallet events, etc.) don't need a TradeAudit/
  // AuditLog row, only order.filled/order.partial_filled/position.closed do,
  // and those three explicitly set it false when the row is created. This
  // keeps `published` (WS delivery) and audit-consumption as independent,
  // non-interfering completion flags on the same durable row.
  auditProcessed Boolean @default(true)
  auditRetries   Int     @default(0)
  // FASE 2.6: same pattern as auditProcessed, for the notification consumer
  // (notification-service/notification.outbox.consumer.ts). Only
  // order.filled and position.closed — the two order-lifecycle notification
  // triggers that already have this transactionally-written row — set it
  // false. Every other event type (margin/risk warnings, wallet events,
  // KYC, support, autopilot, signals, account) is unrelated to the order
  // lifecycle this OutboxEvent row exists for, so it defaults to true and
  // keeps going through notification.router.ts's existing fire-and-forget
  // path unchanged — out of scope for this phase.
  notificationProcessed Boolean @default(true)
  notificationRetries   Int     @default(0)

  @@index([published, createdAt])
  @@index([userId, published])
  @@index([auditProcessed, createdAt])
  @@index([notificationProcessed, createdAt])
}

model Position {
  id                String     @id @default(uuid())
  userId            String
  orderId           String
  symbol            String
  side              String
  quantity          Decimal    @db.Decimal(18, 8)
  entryPrice        Decimal    @db.Decimal(18, 8)
  markPrice         Decimal    @default(0) @db.Decimal(18, 8)
  pnl               Decimal    @default(0) @db.Decimal(18, 8)
  pnlPercent        Decimal    @default(0) @db.Decimal(10, 4)
  marginUsed        Decimal    @db.Decimal(18, 8)
  leverage          Int
  stopLoss          Decimal?   @db.Decimal(18, 8)
  takeProfit        Decimal?   @db.Decimal(18, 8)
  exitPrice         Decimal?   @db.Decimal(18, 8)
  status            String     @default("OPEN")
  openedAt          DateTime   @default(now())
  closedAt          DateTime?
  openedByAutopilot Boolean    @default(false)
  initialStopLoss   Decimal?   @db.Decimal(18, 8)
  breakEvenApplied  Boolean    @default(false)
  trailingActive    Boolean    @default(false)
  Order             Order      @relation(fields: [orderId], references: [id])
  Instrument        Instrument @relation(fields: [symbol], references: [symbol])
  User              User       @relation(fields: [userId], references: [id])
  fills             Fill[]

  @@index([orderId])
  @@index([symbol, status])
  @@index([userId, closedAt])
  @@index([userId, status])
  @@index([openedByAutopilot, status])
}

// FASE 3.8 (Group D): scaffold for external-LP hedging. No real provider
// exists today (see hedge-service/null.hedge.provider.ts) — every row this
// system creates today resolves to status=REJECTED, providerId=NULL_PROVIDER.
// The table exists so the hedge-decision policy and audit trail are real and
// queryable now, ready to plug in an actual external-LP adapter later
// without a schema change.
model HedgeOrder {
  id          String     @id @default(uuid())
  symbol      String
  side        String     // BUY | SELL — the side the HOUSE would trade externally to flatten its book
  notional    Decimal    @db.Decimal(18, 2)
  quantity    Decimal?   @db.Decimal(18, 8) // best-effort, derived from the live quote at decision time
  status      String     // SUBMITTED | REJECTED
  providerId  String     // e.g. "NULL_PROVIDER" until a real adapter is configured
  reason      String     // why this hedge was suggested / why it was rejected
  externalRef String?    // the venue's own order id, once a real provider exists
  requestedAt DateTime   @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
  Instrument  Instrument @relation(fields: [symbol], references: [symbol])

  @@index([symbol, status])
  @@index([createdAt])
}

model RiskWarning {
  id                    String    @id @default(uuid())
  userId                String
  riskScore             Int
  marginLevel           Decimal
  portfolioAggregate    Json
  esmaLeverageActive    Boolean   @default(true)
  negativeBalanceActive Boolean   @default(true)
  liveTradeDisabled     Boolean   @default(false)
  scenarios             Json
  upcomingEvents        Json
  marginForecast        Json
  exposureHeatmap       Json
  killSwitchTriggers    Json
  regulatoryLevel       String
  regulatoryText        String?
  eventCalendarItems    Json
  severity              String    @default("INFO")
  acknowledged          Boolean   @default(false)
  acknowledgedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  User                  User      @relation(fields: [userId], references: [id])

  @@index([userId, acknowledged])
  @@index([userId, createdAt])
  @@index([userId, severity])
}

model Session {
  refreshToken String   @id
  userId       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime @default(dbgenerated("(now() + '7 days'::interval)"))
  User         User     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([userId])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  symbols   String[] @default([])
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id])

