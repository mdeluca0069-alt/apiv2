generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademyContent {
  id             String    @id @default(uuid())
  title          String
  description    String
  category       String
  level          String
  contentType    String
  videoUrl       String?
  duration       Int?
  sections       Json
  caseStudies    Json?
  resources      Json?
  prerequisites  String[]  @default([])
  nextTopics     String[]  @default([])
  relatedContent String[]  @default([])
  viewCount      Int       @default(0)
  completionRate Decimal   @default(0)
  rating         Decimal?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([level])
}

model AccountDailySnapshot {
  id             String   @id @default(uuid())
  userId         String
  snapshotDate   DateTime @db.Date
  balance        Decimal  @db.Decimal(18, 8)
  equity         Decimal  @db.Decimal(18, 8)
  marginUsed     Decimal  @db.Decimal(18, 8)
  freeMargin     Decimal  @db.Decimal(18, 8)
  unrealizedPnl  Decimal  @db.Decimal(18, 8)
  realizedPnlDay Decimal  @db.Decimal(18, 8)
  totalFeesDay   Decimal  @db.Decimal(18, 8)
  totalSwapsDay  Decimal  @db.Decimal(18, 8)
  openPositions  Int
  closedToday    Int
  createdAt      DateTime @default(now())

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  payload   Json
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actor, createdAt])
  @@index([entity, createdAt])
}

model AutopilotConfig {
  id                  String   @id @default(uuid())
  userId              String   @unique
  enabled             Boolean  @default(false)
  mode                String   @default("BALANCED")
  minConfidence       Float    @default(0.70)
  maxRiskPerTrade     Float    @default(0.05)
  maxOpenTrades       Int      @default(3)
  maxExposurePct      Float    @default(20.0)
  allowedSymbols      String[] @default([])
  blockedSymbols      String[] @default([])
  stopDrawdownPct     Float    @default(10.0)
  capitalPct          Float    @default(100.0)
  eventLockMinutes    Int      @default(30)
  maxDailyTrades      Int      @default(10)
  breakEvenTriggerR   Float    @default(1.0)
  trailingStopEnabled Boolean  @default(true)
  trailingActivationR Float    @default(1.5)
  atrTrailMultiple    Float    @default(2.0)
  regimeExitEnabled   Boolean  @default(true)
  maxHoursOpen        Int      @default(48)
  lastDecision        Json?
  // Task 14 Phase 3 — admin pause, distinct from the client's own `enabled`
  // toggle so the client's next config save can never silently un-pause them.
  pausedByAdmin       Boolean   @default(false)
  pausedReason        String?
  pausedAt            DateTime?
  // Real-client safety layer — client consent + per-client daily loss breaker
  // + spread/slippage guard. consentVersion/consentAcceptedAt are denormalized
  // here for fast pipeline reads; AutopilotConsent is the append-only source
  // of truth for disputes.
  consentVersion       String?
  consentAcceptedAt    DateTime?
  maxDailyLossPct      Float     @default(5.0)
  dailyLossLockedUntil DateTime?
  maxSpreadBps         Int       @default(15)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  User                User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Append-only audit trail of every client acceptance of the autopilot risk
// disclosure — distinct from the denormalized fields on AutopilotConfig so a
// client's full consent history survives even if their config is reset.
model AutopilotConsent {
  id         String   @id @default(uuid())
  userId     String
  version    String
  acceptedAt DateTime
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// PHASE2_REMEDIATION (H17): AmlEngine's findings (compliance-engine/
// aml.engine.ts) are already durably written to AuditLog (actor=
// "AML_ENGINE") and survive a restart -- but the compliance officer's
// REVIEW of an alert (status/reviewedBy/note, set via reviewAmlAlert() in
// shared/state.ts) previously lived only in an in-memory Map on the
// BrokerState singleton. A process restart (deploy, crash, PM2 reload)
// silently reverted every reviewed/cleared AML alert back to PENDING,
// discarding the compliance decision history a real broker's regulator
// expects to be durable and auditable. Follows the same status/
// reviewedBy/reviewedAt/note shape KycCase already uses for the same
// "admin reviews a system-generated finding" pattern. Keyed by the same
// deterministic alert id getAmlAlerts() already generates
// (`AML-${auditLogRowId.slice(0,8).toUpperCase()}`), not by a separate
// surrogate key, so a disposition row maps 1:1 onto the AuditLog finding
// it was made against.
model AmlAlertDisposition {
  id         String   @id
  userId     String
  status     String
  reviewedBy String
  note       String?
  reviewedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model BrokerSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientDocument {
  id              String   @id @default(uuid())
  userId          String
  documentKey     String
  label           String
  status          String
  fileName        String?
  rejectionReason String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  User            User     @relation(fields: [userId], references: [id])

  @@unique([userId, documentKey])
  @@index([status])
  @@index([userId, status])
}

model Instrument {
  symbol            String     @id
  name              String
  assetClass        String
  base              String
  quote             String
  precision         Int
  minTradeSize      Decimal
  maxLeverageRetail Int
  createdAt         DateTime   @default(now())
  Order             Order[]
  Position          Position[]
  HedgeOrder        HedgeOrder[]
}

// PHASE C PENTEST (JWT/session/replay finding #1): Sumsub's webhook HMAC
// (X-Payload-Digest = HMAC-SHA256(rawBody, SUMSUB_WEBHOOK_SECRET)) is bound
// only to the body, with no timestamp/nonce -- a captured webhook (proxy
// log, MITM before TLS termination, compromised monitoring pipeline) could
// be replayed at any later time and re-apply its effect (e.g. flipping a
// user's kycStatus back to "approved" after a legitimate later re-review
// rejected them). Every processed webhook's raw-body hash is recorded here
// with a UNIQUE constraint; processSumsubWebhook() atomically tries to
// insert before applying any effect, so a byte-identical replay (whether
// malicious or a benign Sumsub retry) is recognized and no-op'd regardless
// of what the case's CURRENT state has since moved to.
model SumsubWebhookEvent {
  id          String   @id @default(uuid())
  payloadHash String   @unique
  applicantId String?
  type        String
  processedAt DateTime @default(now())

  @@index([applicantId])
}

model KycCase {
  id                 String    @id @default(uuid())
  userId             String    @unique
  status             String    @default("SUBMITTED")
  riskScore          Int       @default(0)
  verificationScore  Int       @default(0)
  reviewNotes        String?
  reviewedBy         String?
  reviewedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sumsubApplicantId  String?
  sumsubReviewStatus String?
  sumsubReviewAnswer String?
  sumsubInspectionId String?
  sumsubWebhookData  Json?
  User               User      @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([sumsubApplicantId])
  @@index([userId])
}

model KycDocument {
  id              String    @id @default(uuid())
  caseId          String
  documentKey     String
  label           String
  status          String    @default("PENDING")
  fileName        String?
  mimeType        String?
