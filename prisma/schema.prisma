  confidence Float?
  result     Json?
  errorMsg   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([caseId])
  @@index([stepType, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LedgerEntry {
  // Fix #11: composite PK, not a bare `id @id`. The Task-14 monthly-
  // partitioning migration (20260619001_ledger_partitioning /
  // 20260619000001_monthly_partitioning_retention) made this table
  // RANGE-partitioned by createdAt, which requires the partition key to be
  // part of every unique/primary constraint — so the live DB's real PK has
  // always been (id, createdAt), named "LedgerEntry_pkey1". This was never
  // reflected here, causing `prisma migrate diff`/`db pull` to report
  // permanent drift. `id` alone is no longer unique or a primary key at the
  // DB level, though it remains globally unique in practice (generated via
  // uuid()), so existing findUnique({where:{id}})-style call sites still
  // behave correctly.
  id             String   @default(uuid())
  userId         String
  currency       String
  amount         Decimal
  type           String
  reference      String
  status         String   @default("COMPLETED")
  note           String   @default("")
  runningBalance Decimal? @db.Decimal(18, 8)
  debitAccount   String?
  creditAccount  String?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])

  @@id([id, createdAt])
  @@index([reference])
  @@index([type, status])
  @@index([userId, createdAt])
  @@index([userId, type, status])
}

model MarginSnapshot {
  id             String   @id @default(uuid())
  userId         String
  equity         Decimal  @db.Decimal(18, 8)
  balance        Decimal  @db.Decimal(18, 8)
  marginUsed     Decimal  @db.Decimal(18, 8)
  freeMargin     Decimal  @db.Decimal(18, 8)
  marginLevelPct Decimal  @db.Decimal(10, 4)
  unrealizedPnl  Decimal  @db.Decimal(18, 8)
  triggerReason  String
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  channel       String
  category      String
  priority      String    @default("NORMAL")
  title         String
  body          String
  templateId    String?
  payload       Json?
  sent          Boolean   @default(false)
  sentAt        DateTime?
  failureReason String?
  retries       Int       @default(0)
  createdAt     DateTime  @default(now())
  // FASE 2.6: idempotency key for notification.outbox.consumer.ts, same
  // reasoning as TradeAudit.sourceOutboxId — a retry after a lost commit
  // ack must land on the same row instead of duplicating it in the user's
  // notification inbox. Composite with `channel` (not a plain unique on
  // sourceOutboxId alone): a single order.filled event creates two rows,
  // one IN_APP and one EMAIL, from the same OutboxEvent id.
  sourceOutboxId String?

  @@index([category, createdAt])
  @@index([channel, sent, createdAt])
  @@index([userId, sent])
  @@unique([sourceOutboxId, channel])
}

model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  pushEnabled  Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  categories   Json     @default("{}")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([userId])
}

model OlosSignal {
