  status          String    @default("QUARANTINE")
  retentionPolicy String    @default("STANDARD")
  retentionUntil  DateTime?
  kycDocumentId   String?
  metadata        Json?
  uploadedAt      DateTime  @default(now())
  deletedAt       DateTime?
  User            User      @relation(fields: [userId], references: [id])

